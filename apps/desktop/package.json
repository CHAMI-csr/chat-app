{
  "name": "@chaty/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && tsc -b && vite build && electron-builder --dir",
    "package:windows": "npm run build:electron && tsc -b && vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.9.155",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "wait-on": "^8.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.chaty.messenger",
    "productName": "Chaty",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "win": { "target": ["nsis"], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
